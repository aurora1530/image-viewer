{
  "name": "image-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "ローカルの画像・動画フォルダーを高速に閲覧するデスクトップアプリ",
  "author": "image-viewer contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build --base ./",
    "desktop:build": "npm run build && electron-builder --win nsis portable",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test": "vitest run --configLoader runner",
    "test:typecheck": "tsc --project tsconfig.tests.json",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:desktop": "playwright test --project=electron",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "jp.local.imageviewer",
    "productName": "ローカル画像ビューワー",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

{
  "name": "image-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "ローカルの画像・動画フォルダーを高速に閲覧するデスクトップアプリ",
  "author": "image-viewer contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build --base ./",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:pack": "npm run build && node scripts/build-desktop.mjs --dir",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test": "vitest run --configLoader runner",
    "test:typecheck": "tsc --project tsconfig.tests.json",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:desktop": "playwright test --project=electron",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:staged": "lint-staged --hide-all --diff-filter=ACMRD",
    "check": "npm run format:check && npm run lint && npm run test:typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.2.4",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "jp.local.imageviewer",
    "productName": "ローカル画像ビューワー",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  }
}
